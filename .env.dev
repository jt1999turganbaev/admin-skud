VITE_API_URL=http://192.168.1.250:8000/

# Dev'da so'rovlar Vite proxy orqali ketadi — cookie'lar bir xil origin'da
# qolishi uchun (Sanctum sessiyasi shunda ishlaydi).
VITE_API_PROXY=true

# Sanctum stateful domeni — proxy so'rovlarida Origin shu qiymatga
# almashtiriladi. Backend'da faqat localhost:3000 stateful (192.168.1.250 emas).
VITE_DEV_PROXY_ORIGIN=http://192.168.1.250:8000
